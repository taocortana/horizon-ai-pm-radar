        "enabled": true,
        "category": "industry-trends"
      }
    ],
    "reddit": {
      "enabled": true,
      "subreddits": [
        {
          "subreddit": "MachineLearning",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 20,
          "min_score": 30
        },
        {
          "subreddit": "LocalLLaMA",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 20,
          "min_score": 30
        },
        {
          "subreddit": "OpenAI",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 15,
          "min_score": 20
        },
        {
          "subreddit": "ClaudeAI",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 15,
          "min_score": 20
        }
      ],
      "users": [],
      "fetch_comments": 5
    },
    "telegram": {
      "enabled": false,
      "channels": []
    },
    "twitter": {
      "enabled": false,
      "mode": "apify",
      "users": [
        "sama",
        "karpathy",
        "AndrewYNg",
        "demishassabis",
        "ylecun",
        "fchollet",
        "alexandr_wang"
      ],
      "fetch_limit": 30,
      "fetch_reply_text": false,
      "max_replies_per_tweet": 3,
      "max_tweets_to_expand": 10,
      "reply_min_likes": 20
    },
    "openbb": {
      "enabled": false,
      "fetch_filings": false,
      "filings_provider": "sec",
      "watchlists": []
    },
    "ossinsight": {
      "enabled": true,
      "period": "past_24_hours",
      "languages": [
        "All",
        "Python",
        "TypeScript"
      ],
      "keywords": [
        "artificial intelligence",
        "generative ai",
        "large language model",
        "llm",
        "ai agent",
        "agents",
        "multimodal",
        "model context protocol",
        "mcp",
        "inference"
      ],
      "min_stars": 20,
      "max_items": 25
    },
    "gdelt": {
      "enabled": true,
      "query": "(\"artificial intelligence\" OR \"generative AI\" OR \"AI agent\")",
      "mode": "ArtList",
      "max_records": 40,
      "timespan": "24h",
      "language": "english",
      "country": null,
      "category": "industry-trends"
    },
    "google_news": {
      "enabled": true,
      "query": "\"人工智能\" (新技术 OR 新产品 OR 新应用 OR 大模型 OR 智能体 OR 融资 OR 趋势)",
      "language": "zh-CN",
      "country": "CN",
      "ceid": "CN:zh-Hans",
      "max_results": 40,
      "category": "industry-trends"
    }
  },
  "filtering": {
    "ai_score_threshold": 7.0,
    "time_window_hours": 24,
    "max_items": 20,
    "category_groups": {
      "frontier": {
        "name": "前沿技术",
        "limit": 5,
        "categories": [
          "frontier-ai",
          "ai-research",
          "ai-infrastructure"
        ]
      },
      "products": {
        "name": "产品与应用",
        "limit": 6,
        "categories": [
          "ai-products",
          "ai-applications",
          "product-updates",
          "ai-tools"
        ]
      },
      "industry": {
        "name": "行业与趋势",
        "limit": 5,
        "categories": [
          "industry-trends",
          "business"
        ]
      },
      "voices": {
        "name": "人物与观点",
        "limit": 4,
        "categories": [
          "voices",
          "analysis"
        ]
      }
    },
    "default_group": "other",
    "default_group_limit": 5
  },
  "webhook": {
    "enabled": false,
    "url_env": "HORIZON_WEBHOOK_URL",
    "delivery": "summary",
    "overview_position": "first",
    "platform": "generic",
    "layout": "markdown",
    "fallback_layout": "markdown",
    "languages": [
      "zh"
    ],
    "request_body": {
      "text": "#{message_title}\n#{summary}"
    },
    "headers": ""
  }
}
